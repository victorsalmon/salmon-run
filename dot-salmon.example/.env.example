# Salmon Run runtime environment
# Copy this file to ~/.salmon/.env and fill in or redirect every variable.
# No secrets should be committed; this example is a public template.

# --- Model-provider tokens (examples) ---
# Set directly when you are comfortable with a literal value:
# OPENCODE_GO_KEY=sk-...
# DEVIN_API_KEY=...
# DEEPSEEK_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-...
# DEEPINFRA_API_KEY=...

# OpenCode (opencode-go) provider token. Used by the OpenCode PondEngine
# executor (Modules/SalmonRun.PondEngine/Executors/Opencode.ps1):
# OPENCODE_GO_KEY=sk-...
# or redirect to a file that contains only the token:
# OPENCODE_GO_KEY=File ~/.opencode/key
# or to another environment variable:
# OPENCODE_GO_KEY=Env OPENCODE_GO_KEY

# Devin (devin) provider token. Used by the Devin PondEngine executor
# (Modules/SalmonRun.PondEngine/Executors/Devin.ps1) via Resolve-DevinCredential:
# DEVIN_API_KEY=sk-...
# or redirect to another environment variable:
# DEVIN_API_KEY=Env DEVIN_API_KEY
# or to a file that contains only the token:
# DEVIN_API_KEY=File ~/.devin/key

# DeepSeek (dsh) provider token. Used by the DSH PondEngine executor
# (Modules/SalmonRun.PondEngine/Executors/Dsh.ps1) via Resolve-DshCredential:
# DEEPSEEK_API_KEY=sk-...
# or redirect to another environment variable:
# DEEPSEEK_API_KEY=Env DEEPSEEK_API_KEY
# or to a file that contains only the token:
# DEEPSEEK_API_KEY=File ~/.salmon/secrets/deepseek.key

# OpenRouter token for DeepSeek/DSH. The DSH executor maps model slugs to
# openrouter/deepseek-v4-flash and openrouter/deepseek-v4-pro.
# OPENROUTER_API_KEY=sk-...
# or redirect to another environment variable:
# OPENROUTER_API_KEY=Env OPENROUTER_API_KEY
# or to a file that contains only the token:
# OPENROUTER_API_KEY=File ~/.salmon/secrets/openrouter.key
# or read from AWS Secrets Manager:
# OPENROUTER_API_KEY=AWS default secretsmanager my-org/openrouter API_KEY

# DeepInfra token for DeepSeek/DSH. The DSH executor maps model slugs to
# deepseek-ai/DeepSeek-V4-Flash-0731 and deepseek-ai/DeepSeek-V4-Pro.
# DEEPINFRA_API_KEY=...
# or redirect to another environment variable:
# DEEPINFRA_API_KEY=Env DEEPINFRA_API_KEY
# or to a file that contains only the token:
# DEEPINFRA_API_KEY=File ~/.salmon/secrets/deepinfra.key
# or read from AWS Secrets Manager:
# DEEPINFRA_API_KEY=AWS default secretsmanager my-org/deepinfra API_KEY

# Or redirect through another source. Supported first words:
#   Env, File, AWS, GitHub, Worktree

# Read from a different environment variable:
# OPENROUTER_API_KEY=Env OPENROUTER_API_KEY_STORED

# Read from a file that contains only the token:
# OPENROUTER_API_KEY=File ~/.salmon/secrets/openrouter.key

# Read an AWS config value (useful for SSO profiles):
# AWS_PROFILE_NAME=AWS default config sso_start_url
# AWS_REGION=AWS default config region

# Read an AWS credential value from ~/.aws/credentials:
# AWS_ACCESS_KEY_ID=AWS default credentials aws_access_key_id
# AWS_SECRET_ACCESS_KEY=AWS default credentials aws_secret_access_key

# Read a key from an AWS Secrets Manager secret:
# OPENROUTER_API_KEY=AWS default secretsmanager salmon-run/openrouter API_KEY

# GitHub token redirect (repository secrets are write-only, so point at an env var):
# GITHUB_TOKEN=GitHub token GITHUB_TOKEN_STORED
# GITHUB_TOKEN_READ=Env GITHUB_TOKEN_STORED
# GITHUB_TOKEN_PUSH=Env GITHUB_TOKEN_STORED

# Generic GitCloud token fallback; can also be typed per operation:
# SALMON_RUN_GITCLOUD_TOKEN=File ~/.salmon/git/worktree-api-token
# SALMON_RUN_GITCLOUD_TOKEN_READ=File ~/.salmon/git/worktree-api-token
# SALMON_RUN_GITCLOUD_TOKEN_PUSH=File ~/.salmon/git/worktree-api-token

# GitHub token redirect (repository secrets are write-only, so point at an env var):
# GITHUB_TOKEN=GitHub token GITHUB_TOKEN_STORED
# GITHUB_TOKEN_READ=Env GITHUB_TOKEN_STORED
# GITHUB_TOKEN_PUSH=Env GITHUB_TOKEN_STORED

# Worktree / Gitea-compatible host. Redirect through an env var (no secret committed here).
WORKTREE_HOST=Env WORKTREE_HOST

# GitCloud push resolver redirects. Values resolve through SalmonRun.Credentials from
# the environment; no secret is committed in this public template.
GITHUB_TOKEN=Env GITHUB_TOKEN
WORKTREE_REPO_RW_ACCESS_TOKEN=Env WORKTREE_REPO_RW_ACCESS_TOKEN

# Worktree repository token (Gitea-compatible host). Use a resolver or env var.
# The canonical local path is ~/.salmon/git/worktree-api-token (see dot-salmon.example/git/README.md).
# WORKTREE_REPO_RW_ACCESS_TOKEN=File ~/.salmon/git/worktree-api-token
# WORKTREE_REPO_RW_ACCESS_TOKEN=AWS dev secretsmanager my-org/Worktree/API_TOKEN API_TOKEN

# --- Orchestrator settings ---
SALMON_RUN_LOG_LEVEL=Info
