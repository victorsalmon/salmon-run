# Salmon Run runtime environment
# Copy this file to ~/.salmon/.env and fill in or redirect every variable.
# No secrets should be committed; this example is a public template.

# --- Model-provider tokens (examples) ---
# Set directly when you are comfortable with a literal value:
# OPENROUTER_API_KEY=sk-...

# Or redirect through another source. Supported first words:
#   Env, File, AWS, GitHub, Worktree

# Read from a different environment variable:
# OPENROUTER_API_KEY=Env OPENROUTER_API_KEY_STORED

# Read from a file that contains only the token:
# OPENROUTER_API_KEY=File ~/.salmon/secrets/openrouter.key

# Read an AWS config value (useful for SSO profiles):
# AWS_PROFILE_NAME=AWS default config sso_start_url
# AWS_REGION=AWS default config region

# Read an AWS credential value from ~/.aws/credentials:
# AWS_ACCESS_KEY_ID=AWS default credentials aws_access_key_id
# AWS_SECRET_ACCESS_KEY=AWS default credentials aws_secret_access_key

# Read a key from an AWS Secrets Manager secret:
# OPENROUTER_API_KEY=AWS default secretsmanager salmon-run/openrouter API_KEY

# GitHub token redirect (repository secrets are write-only, so point at an env var):
# GITHUB_TOKEN=GitHub token GITHUB_TOKEN_STORED

# Worktree repository secret (Gitea-compatible host):
# WORKTREE_API_TOKEN=Worktree clocklobster salmon-run api-token

# --- Orchestrator settings ---
SALMON_RUN_LOG_LEVEL=Info
