{
    "RuntimeHome": "~/.salmon",
    "Tasks": {
        "Code": "~/.salmon/Tasks/Code",
        "Review": "~/.salmon/Tasks/Review",
        "Audit": "~/.salmon/Tasks/Audit",
        "QA": "~/.salmon/Tasks/QA",
        "Working": "~/.salmon/Tasks/Working",
        "Complete": "~/.salmon/Tasks/Complete",
        "Failed": "~/.salmon/Tasks/Failed",
        "Manual": "~/.salmon/Tasks/Manual",
        "Handoffs": "~/.salmon/Tasks/Handoffs",
        "Temp": "~/.salmon/Tasks/Temp",
        "Logs": "~/.salmon/Tasks/Logs"
    },
    "Plugins": {
        "InstallFrom": "Skills"
    },
    "LogLevel": "INFO",
    "execution": {
        "defaults": {
            "challenge": "Daily",
            "harness": "opencode",
            "provider": "opencode-go",
            "effort": "max",
            "timeoutMinutes": 30,
            "costCeiling": 25.0
        },
        "ponds": {
            "Code": { "timeoutMinutes": 60 },
            "Audit": { "challenge": "Complex", "timeoutMinutes": 60 },
            "QA": { "challenge": "Complex", "timeoutMinutes": 120 }
        }
    }
}
