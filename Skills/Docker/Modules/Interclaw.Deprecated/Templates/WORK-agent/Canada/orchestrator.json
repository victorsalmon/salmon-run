{
  "$schema": "https://ORCHESTRATOR.io/schema/config.v2.json",
  "agents": {
    "defaults": {
      "model": {
        "primary": "amazon-bedrock/amazon.nova-lite-v1:0",
        "fallbacks": []
      }
    }
  },
  "models": {
    "providers": {
      "amazon-bedrock": {
        "baseUrl": "https://bedrock-runtime.ca-central-1.amazonaws.com",
        "api": "bedrock-converse-stream",
        "auth": "aws-sdk",
        "models": [
          {
            "id": "amazon.nova-lite-v1:0",
            "name": "Nova Lite",
            "contextWindow": 200000,
            "maxTokens": 10000
          }
        ]
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": false
    }
  }
}
