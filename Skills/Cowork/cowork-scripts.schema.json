{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ORCHESTRATOR.ai/schemas/cowork-scripts.schema.json",
  "title": "CoworkScript",
  "description": "Contract for Cowork utility scripts — defines parameters, outputs, and safety guarantees for agent-run scripts",
  "type": "object",
  "required": ["name", "path", "description", "parameters", "outputs", "dependencies", "idempotent", "tags"],
  "properties": {
    "name": { "type": "string", "description": "Unique script identifier (kebab-case)" },
    "path": { "type": "string", "description": "Relative path from repo root to the script file" },
    "description": { "type": "string", "description": "One-sentence summary of what the script does" },
    "parameters": {
      "type": "array",
      "items": { "$ref": "#/$defs/Parameter" }
    },
    "outputs": { "$ref": "#/$defs/Output" },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Script names or external requirements this script depends on"
    },
    "idempotent": { "type": "boolean", "description": "Safe to re-run without side effects?" },
    "tags": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "Parameter": {
      "type": "object",
      "required": ["name", "type", "mandatory", "description"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["string", "switch", "hashtable", "string[]", "hashtable[]"] },
        "mandatory": { "type": "boolean" },
        "description": { "type": "string" }
      }
    },
    "Output": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["file", "stdout"] },
        "pathPattern": { "type": "string", "description": "Glob pattern for output file locations (only for type=file)" }
      }
    }
  },
  "examples": [
    {
      "name": "new-lock-header",
      "path": "Skills/Workflows/Cowork/Scripts/New-LockHeader.ps1",
      "description": "Generate or append a Lock Header for agent chain-of-possession tracking",
      "parameters": [
        { "name": "AgentId", "type": "string", "mandatory": true, "description": "Agent identity string" },
        { "name": "Status", "type": "string", "mandatory": true, "description": "locked or released" },
        { "name": "DryRun", "type": "switch", "mandatory": false, "description": "Output to stdout instead of file" }
      ],
      "outputs": { "type": "file", "pathPattern": "Tasks/Working/**/*.md" },
      "dependencies": [],
      "idempotent": true,
      "tags": ["cowork", "utility", "lock-header"]
    }
  ]
}