<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{Title}} - Project Status</title>
<style>
  :root {
    --bg-deep: #121214;
    --bg-surface: #1e293b;
    --bg-card: #1e293b;
    --accent: #e11d48;
    --accent-hover: #be123c;
    --text-primary: #f1f5f9;
    --text-secondary: #94a3b8;
    --text-muted: #64748b;
    --border: #334155;
    --success: #22c55e;
    --warning: #eab308;
    --danger: #ef4444;
    --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-display: 'Outfit', 'Inter', -apple-system, sans-serif;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: var(--font-sans); background: var(--bg-deep); color: var(--text-primary); line-height: 1.6; padding: 2rem 1rem; }
  .container { max-width: 800px; margin: 0 auto; }
  .header { padding: 2rem 1rem; margin-bottom: 2rem; border-bottom: 1px solid var(--border); }
  .header h1 { font-family: var(--font-display); font-size: 2rem; font-weight: 700; background: linear-gradient(135deg, var(--text-primary), var(--accent)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .header .meta { color: var(--text-secondary); margin-top: 0.5rem; display: flex; gap: 1rem; flex-wrap: wrap; }
  .header .meta span { display: flex; align-items: center; gap: 0.25rem; }
  .card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; margin-bottom: 1.5rem; backdrop-filter: blur(8px); }
  .card h2 { font-family: var(--font-display); font-size: 1.125rem; margin-bottom: 1rem; color: var(--text-primary); display: flex; align-items: center; gap: 0.5rem; }
  .milestone { margin-bottom: 1rem; }
  .milestone-header { display: flex; justify-content: space-between; margin-bottom: 0.25rem; }
  .milestone-header .name { color: var(--text-primary); font-weight: 500; }
  .milestone-header .pct { color: var(--text-secondary); font-size: 0.875rem; }
  .progress-bar { width: 100%; height: 8px; background: var(--bg-deep); border-radius: 4px; overflow: hidden; }
  .progress-fill { height: 100%; border-radius: 4px; transition: width 0.3s; }
  .progress-fill.green { background: var(--success); }
  .progress-fill.yellow { background: var(--warning); }
  .progress-fill.red { background: var(--danger); }
  .risk-indicators { display: flex; gap: 0.5rem; flex-wrap: wrap; margin: 1rem 0; }
  .risk-indicator { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.375rem 0.75rem; border-radius: 20px; font-size: 0.8125rem; font-weight: 500; }
  .risk-indicator.green { background: rgba(34,197,94,0.15); color: var(--success); }
  .risk-indicator.yellow { background: rgba(234,179,8,0.15); color: var(--warning); }
  .risk-indicator.red { background: rgba(239,68,68,0.15); color: var(--danger); }
  .risk-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
  .risk-dot.green { background: var(--success); }
  .risk-dot.yellow { background: var(--warning); }
  .risk-dot.red { background: var(--danger); }
  .checklist { list-style: none; }
  .checklist li { padding: 0.5rem 0; display: flex; align-items: center; gap: 0.5rem; color: var(--text-secondary); }
  .checklist li.done { color: var(--success); }
  .checklist li.done::before { content: "✓"; color: var(--success); font-weight: 700; }
  .checklist li.pending::before { content: "○"; color: var(--text-muted); }
  .status-badge { display: inline-block; padding: 0.25rem 0.75rem; border-radius: 20px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }
  .status-badge.on-track { background: rgba(34,197,94,0.15); color: var(--success); }
  .status-badge.at-risk { background: rgba(234,179,8,0.15); color: var(--warning); }
  .status-badge.blocked { background: rgba(239,68,68,0.15); color: var(--danger); }
  @media (max-width: 767px) {
    .header h1 { font-size: 1.5rem; }
    .card { padding: 1rem; }
    .risk-indicators { flex-direction: column; }
  }
  @media print {
    body { background: #fff; color: #000; padding: 0; }
    .card { border: 1px solid #ddd; break-inside: avoid; }
    .header h1 { -webkit-text-fill-color: #000; background: none; }
  }
</style>
</head>
<body>
<div class="container">
  <div class="header">
    <h1>{{Title}}</h1>
    <div class="meta">
      <span><strong>Client:</strong> {{Client}}</span>
      <span><strong>Updated:</strong> {{Updated}}</span>
      <span><strong>Status:</strong> <span class="status-badge {{StatusClass}}">{{Status}}</span></span>
    </div>
  </div>

  <div class="card">
    <h2>Milestone Progress</h2>
    {{Milestones}}
  </div>

  <div class="card">
    <h2>Risks & Issues</h2>
    <div class="risk-indicators">
      {{Risks}}
    </div>
  </div>

  <div class="card">
    <h2>Next Steps</h2>
    <ul class="checklist">
      {{NextSteps}}
    </ul>
  </div>

  {{#if Summary}}
  <div class="card">
    <h2>Summary</h2>
    <p>{{Summary}}</p>
  </div>
  {{/if}}
</div>
</body>
</html>
