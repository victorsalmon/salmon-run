<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{Title}} - Client Onboarding Guide</title>
<style>
  :root {
    --bg-deep: #121214;
    --bg-surface: #1e293b;
    --bg-card: #1e293b;
    --accent: #e11d48;
    --accent-hover: #be123c;
    --text-primary: #f1f5f9;
    --text-secondary: #94a3b8;
    --text-muted: #64748b;
    --border: #334155;
    --success: #22c55e;
    --warning: #eab308;
    --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-display: 'Outfit', 'Inter', -apple-system, sans-serif;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: var(--font-sans); background: var(--bg-deep); color: var(--text-primary); line-height: 1.6; padding: 2rem 1rem; }
  .container { max-width: 900px; margin: 0 auto; }
  .hero { text-align: center; padding: 3rem 1rem; margin-bottom: 2rem; }
  .hero h1 { font-family: var(--font-display); font-size: 2.5rem; font-weight: 700; margin-bottom: 0.5rem; background: linear-gradient(135deg, var(--text-primary), var(--accent)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .hero p { color: var(--text-secondary); font-size: 1.125rem; max-width: 600px; margin: 0 auto; }
  .card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; margin-bottom: 1.5rem; backdrop-filter: blur(8px); }
  .card h2 { font-family: var(--font-display); font-size: 1.25rem; margin-bottom: 1rem; color: var(--text-primary); display: flex; align-items: center; gap: 0.5rem; }
  .card h2 .step-num { background: var(--accent); color: #fff; width: 28px; height: 28px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 0.875rem; font-weight: 700; }
  .steps { counter-reset: step; }
  .step-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; margin-bottom: 1rem; }
  .step-card h3 { font-family: var(--font-display); margin-bottom: 0.5rem; }
  .step-card h3::before { counter-increment: step; content: "Step " counter(step) ": "; color: var(--accent); }
  .step-card p { color: var(--text-secondary); }
  .timeline { display: flex; gap: 0.5rem; flex-wrap: wrap; margin: 1rem 0; }
  .timeline-item { flex: 1; min-width: 120px; background: var(--bg-deep); border: 1px solid var(--border); border-radius: 8px; padding: 0.75rem; text-align: center; }
  .timeline-item .date { font-size: 0.75rem; color: var(--text-muted); }
  .timeline-item .label { font-size: 0.875rem; color: var(--text-primary); margin-top: 0.25rem; }
  table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
  th, td { padding: 0.75rem; text-align: left; border-bottom: 1px solid var(--border); }
  th { color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; }
  td { color: var(--text-secondary); }
  .btn { display: inline-block; background: var(--accent); color: #fff; padding: 0.75rem 1.5rem; border-radius: 8px; text-decoration: none; font-weight: 600; transition: background 0.2s; }
  .btn:hover { background: var(--accent-hover); }
  @media (max-width: 767px) {
    .hero h1 { font-size: 1.75rem; }
    .card { padding: 1rem; }
    .timeline-item { min-width: 100%; }
  }
  @media print {
    body { background: #fff; color: #000; padding: 0; }
    .card { border: 1px solid #ddd; break-inside: avoid; }
    .hero h1 { -webkit-text-fill-color: #000; background: none; }
  }
</style>
</head>
<body>
<div class="container">
  <div class="hero">
    <h1>{{Title}}</h1>
    <p>{{Intro}}</p>
  </div>

  {{#if Timeline}}
  <div class="card">
    <h2>Timeline</h2>
    <div class="timeline">
      {{Timeline}}
    </div>
  </div>
  {{/if}}

  <div class="card">
    <h2>Steps</h2>
    <div class="steps">
      {{Steps}}
    </div>
  </div>

  {{#if Deliverables}}
  <div class="card">
    <h2>Deliverables</h2>
    <table>
      <thead><tr><th>Item</th><th>Due</th><th>Owner</th></tr></thead>
      <tbody>{{Deliverables}}</tbody>
    </table>
  </div>
  {{/if}}

  {{#if NextSteps}}
  <div class="card">
    <h2>Next Steps</h2>
    <p>{{NextSteps}}</p>
  </div>
  {{/if}}
</div>
</body>
</html>
